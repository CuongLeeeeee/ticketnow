{
  "ReverseProxy": {
    "Routes": {
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/events/{**catch-all}" }
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/events/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5001/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Path": "/health"
          }
        }
      }
    }
  }
}