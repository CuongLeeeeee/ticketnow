{
  "Jwt": {
    "Issuer": "ticketnow-identity",
    "Audience": "ticketnow-api",
    "SigningKey": "dev-only-ticketnow-signing-key-change-me-min-32-bytes!!"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "login",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Order": 10,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/events/{**catch-all}" }
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/admin/events/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "identity-1": { "Address": "http://localhost:5002/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Path": "/health"
          }
        }
      },
      "catalog": {
        "Destinations": { "catalog-1": { "Address": "http://localhost:5001/" } },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Path": "/health"
          }
        }
      }
    }
  }
}